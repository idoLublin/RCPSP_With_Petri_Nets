 // ============================================================================
 // Main Entry Point
 // ============================================================================
+// ============================================================================
+// Root LBER evaluation (--root-lb): destructive LBER root bound per instance,
+// no search. One CSV row per instance; CP at root included as a cross-check.
+// ============================================================================
+extern thread_local int lberRootBound;
+
+int evaluateRootLBER(const Config& config) {
+    std::string filename = generateOutputFilename(config);
+    std::ofstream out(filename);
+    if (!out.is_open()) {
+        std::cerr << "Failed to open output file: " << filename << std::endl;
+        return 1;
+    }
+    out << "Group,Exam,LBER,CP\n";
+    lberMode = "root";
+    lberDepth = config.lberDepth;
+
+    for (int group = config.groupStart; group <= config.groupEnd; ++group) {
+        for (int exam = config.examStart; exam <= config.examEnd; ++exam) {
+            petri.reset();
+            RCPSPex.reset();
+            heuristicDPInitialized = false;
+            lbccInitialized = false;
+            energeticInitialized = false;
+            lberRootComputed = false;
+
+            getPetri(petri, group, exam, config.problemType);
+            getRCPSP(RCPSPex, group, exam, config.problemType);
+            if (petri.Transitions.empty()) {
+                std::cerr << "skip g" << group << " e" << exam << " (load failed)" << std::endl;
+                continue;
+            }
+            setSearchTimeout(config.timeLimit);
+
+            std::vector<short> unf;
+            for (int t = 1; t <= (int)petri.Transitions.size(); ++t) unf.push_back(t);
+            double cpH = getForwardHcostDP(unf, {});
+
+            computeRootBound(config.lberDepth);
+
+            out << group << "," << exam << "," << lberRootBound << "," << cpH << "\n";
+            out.flush();
+            std::cout << "root-lb " << config.problemType << " g" << group << " e" << exam
+                      << ": lber(d" << config.lberDepth << ")=" << lberRootBound
+                      << " cp=" << cpH << std::endl;
+        }
+    }
+    out.close();
+    std::cout << "LBER root results written to " << filename << std::endl;
+    return 0;
+}
+
 int main(int argc, char *argv[]) {
     Config config = parseArgs(argc, argv);
-    
+
     if (config.showHelp) {
         printUsage(argv[0]);
         return 0;
     }
-    
+
+    if (config.rootLB) {
+        return evaluateRootLBER(config);
+    }
+
     runSolver(config);
     return 0;
 }
